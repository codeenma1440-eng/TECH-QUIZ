# Variable NAMES only - never commit real values. Set these in the host's environment (e.g. Render dashboard).
NODE_ENV=production
# Render injects PORT automatically; only set it locally (falls back to 3000)
PORT=
# SQLite database file (on the persistent disk in production)
DB_FILE=/data/quiz.db
# Directory for uploaded question images (on the persistent disk in production)
UPLOAD_DIR=/data/uploads
# REQUIRED: admin login, applied to the primary ADMIN account on every start
ADMIN_USERNAME=
ADMIN_PASSWORD=
# REQUIRED in production: long random string (32+ chars) used to sign login tokens
JWT_SECRET=
# Optional: speed bonus window in seconds (bonus decays linearly from +50% of marks to 0 over this time)
BONUS_WINDOW_SEC=30
